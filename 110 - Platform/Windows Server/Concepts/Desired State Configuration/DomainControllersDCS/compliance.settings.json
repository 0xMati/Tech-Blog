{
  "SchemaVersion": 1,
  "BaselineVersion": "1.0.0",
  "MaximumInventoryAgeHours": 24,
  "DscExecutable": "C:\\Tools\\DSC\\dsc.exe",
  "DscVersion": "3.2.3",
  "ModuleVersions": {
    "PSDscResources": "2.12.0.0",
    "ComputerManagementDsc": "10.0.0",
    "AuditPolicyDsc": "1.4.0.0"
  },
  "ExcludedDCs": [],
  "Controls": [
    {
      "Id": "DC-01-Spooler",
      "Name": "Print Spooler stopped and disabled",
      "Owner": "DSC",
      "Mode": "Audit",
      "ResourceType": "PSDscResources/Service",
      "Properties": {
        "Name": "Spooler",
        "Ensure": "Present",
        "State": "Stopped",
        "StartupType": "Disabled"
      }
    },
    {
      "Id": "DC-02-SMB1",
      "Name": "SMB server protocol version 1 disabled",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "ComputerManagementDsc/SmbServerConfiguration",
      "Properties": {
        "IsSingleInstance": "Yes",
        "EnableSMB1Protocol": false
      }
    },
    {
      "Id": "DC-02-Signing",
      "Name": "SMB server signing required",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "ComputerManagementDsc/SmbServerConfiguration",
      "Properties": {
        "IsSingleInstance": "Yes",
        "RequireSecuritySignature": true
      }
    },
    {
      "Id": "DC-03-Logon",
      "Name": "Logon audit: success and failure",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "AuditPolicyDsc/AuditPolicyGUID",
      "Properties": {
        "Name": "Logon",
        "AuditFlag": "Success And Failure",
        "Ensure": "Present"
      }
    },
    {
      "Id": "DC-03-Accounts",
      "Name": "User account management audit: success and failure",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "AuditPolicyDsc/AuditPolicyGUID",
      "Properties": {
        "Name": "User Account Management",
        "AuditFlag": "Success And Failure",
        "Ensure": "Present"
      }
    },
    {
      "Id": "DC-03-DirectoryChanges",
      "Name": "Directory service changes audit: success",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "AuditPolicyDsc/AuditPolicyGUID",
      "Properties": {
        "Name": "Directory Service Changes",
        "AuditFlag": "Success",
        "Ensure": "Present"
      }
    },
    {
      "Id": "DC-04-Security",
      "Name": "Security log: 1 GiB, overwrite oldest events",
      "Owner": "DSC",
      "Mode": "Audit",
      "ResourceType": "ComputerManagementDsc/WindowsEventLog",
      "Properties": {
        "LogName": "Security",
        "MaximumSizeInBytes": 1073741824,
        "LogMode": "Circular"
      }
    },
    {
      "Id": "DC-04-System",
      "Name": "System log: 64 MiB, overwrite oldest events",
      "Owner": "DSC",
      "Mode": "Audit",
      "ResourceType": "ComputerManagementDsc/WindowsEventLog",
      "Properties": {
        "LogName": "System",
        "MaximumSizeInBytes": 67108864,
        "LogMode": "Circular"
      }
    },
    {
      "Id": "DC-04-Directory",
      "Name": "Directory Service log: 128 MiB, overwrite oldest events",
      "Owner": "DSC",
      "Mode": "Audit",
      "ResourceType": "ComputerManagementDsc/WindowsEventLog",
      "Properties": {
        "LogName": "Directory Service",
        "MaximumSizeInBytes": 134217728,
        "LogMode": "Circular"
      }
    },
    {
      "Id": "DC-05-Signing",
      "Name": "Explicit LDAP signing policy: Require signing",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "PSDscResources/Registry",
      "Properties": {
        "Key": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters",
        "ValueName": "LDAPServerIntegrity",
        "ValueType": "DWord",
        "ValueData": ["2"],
        "Ensure": "Present"
      }
    },
    {
      "Id": "DC-05-ChannelBinding",
      "Name": "Explicit LDAP channel binding policy: Always",
      "Owner": "GPO",
      "Mode": "Audit",
      "ResourceType": "PSDscResources/Registry",
      "Properties": {
        "Key": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters",
        "ValueName": "LdapEnforceChannelBinding",
        "ValueType": "DWord",
        "ValueData": ["2"],
        "Ensure": "Present"
      }
    }
  ]
}