{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Blog.DC/Spooler",
  "version": "1.0.0",
  "description": "Reads and manages the local Print Spooler service without the DSC LCM.",
  "kind": "resource",
  "get": {
    "executable": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-File", "Invoke-NativeResource.ps1", "-Resource", "Spooler", "-Operation", "Get"],
    "input": "stdin"
  },
  "set": {
    "executable": "powershell.exe",
    "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-File", "Invoke-NativeResource.ps1", "-Resource", "Spooler", "-Operation", "Set"],
    "input": "stdin",
    "return": "state"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string", "const": "Spooler" },
        "State": { "type": "string", "enum": ["Running", "Stopped"] },
        "StartupType": { "type": "string", "enum": ["Automatic", "Manual", "Disabled"] }
      }
    }
  }
}