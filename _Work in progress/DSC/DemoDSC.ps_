# Introduction to desired state configuration (DSC)
# ============================================================
$ServerName = "mprootsrvt0.megapoc.com"
$WebsiteFilePath = "C:\inetpub"

# The configuration script 
# ------------------------
    # A DSC configuration is declared via keyword "configuration" followed by a script bloc containing:
    #    - Optional parameters
    #    - One or several configuration blocks which starts with keyword "Node" for targetted nodes 
    #    - One or several resource blocks per resource to configure

        # The following configuration simply checks folder c:\temp\DSCDir is present and creates it if not present
        Configuration ConfigDir1
        {
            node localhost
            {
                File CreateFolder
                {
                    DestinationPath = 'c:\temp\DSCdir1\'
                    Ensure = 'Present'
                    Type = 'Directory'
                }
            }
        }

        # The following configuration configures a web server. It takes the node name and the web site file path as parameters
        Configuration MyWebConfig
        {
           param ($ServerName, $WebsiteFilePath)

           # A Configuration block can have one or more Node blocks
           Node $ServerName
           {
              # Ensure the Web Server (IIS) role is installed
              WindowsFeature IIS
              {
                  Ensure = "Present"
                  Name = "Web-Server" # Use the Name property from Get-WindowsFeature
              }

              # Create files and directory for the web sites 
              File WebDirectory
              {
                 Ensure = "Present"  
                 Type = "Directory" # Default is "File"
                 Recurse = $true
                 SourcePath = $WebsiteFilePath  # File share containing web applications (\\didadm1\webapps)
                 DestinationPath = "C:\inetpub\wwwroot"
              }
           }
        }


# Ressources
# ----------
    # DSC resources can be retreived via cmdlet get-dscresource
    $dscresources = get-dscresource  
    $dscresources | format-table name,ImplementedAs,properties -autosize
    # Resource types can be "binary", "PowerShell" or "composite". The type of a resource is stored in attribute "implementedAs" of its object
    # For example, resource "registry" type is Powershell. The path to its module is stored in attribute "Path" of its object 
    #   and its folder is stored in attribute "parentPath"
    get-dscresource registry | format-list *
    dir (get-dscresource  registry).parentpath


# MOF files
# ---------
    # Execute configuration configDir1 we created previously to generate the MOF file for localhost. We do not pass parameter as it takes none
    configDir1 -OutputPath c:\temp\configDir1
    # Directory config1Dir1 has been created. It contains a MOF file for the node it has been designed for (which is localhost)
    dir C:\temp\ConfigDir1

    # The MOF file contains one bloc of resource properties for the folder
    #    "ResourceID=[file]CreateFolder" which indicates it manages a file resource
    #    "Type=Directory" which indicates the type of the resource is a file
    #    "Ensure=present" which indicates to create the resource must be created if not present,
    #    "DestinationPath = "c:\\temp\\DSCdir1\\" which indicates the destination path of the resource
    notepad C:\temp\ConfigDir1\localhost.mof

    # Execute configuration MyWebConfig we created previously to generate the MOF File for the web server (passed via parameter serverName we 
    # declared in the configuration). We also pass the share for the web site files as a parameter (WebsiteFilePath)
    MyWebConfig -ServerName $ServerName -WebsiteFilePath $WebsiteFilePath -outputpath c:\temp\MyWebConfig
    # MOF file mprootweb1.mof has been created
    dir C:\temp\MyWebConfig
    # The MOF files contains two blocs of resource propeties (one for Windows feature IIS and the other for the folder of web files)
    notepad C:\temp\MyWebConfig\$servername.mof



# Local Configuration Manager (LCM)
# ---------------------------------
    # Cmdlet Get-dscLocalConfigurationManager allows retreiving the configuration manager settings of a node 
    Get-dscLocalConfigurationManager
    
    # It can be changed via a DSC configuration
    LocalConfigurationManager
    {
        ConfigurationID = "646e48cb-3082-4a12-9fd9-f71b9a562d4e"
        ConfigurationModeFrequencyMins = 90
        ConfigurationMode = "ApplyAndAutocorrect"
        RefreshFrequencyMins = 45
        DownloadManagerName = "WebDownloadManager"
        RefreshMode = "Pull"
        DownloadManagerCustomData = 
	     (@{ServerUrl="https://$PullServer/psdscpullserver.svc"})
        CertificateID = "71AA68562316FE3F73536F1096B85D66289ED60E"
        Credential = $cred
        RebootNodeIfNeeded = $true
        AllowModuleOverwrite = $false
    }


# Push configuration
# ------------------
    # We will push the two configurations we created to their servers
        # Check folder C:\temp\DSCdir1 does not exist locally
        get-item C:\temp\DSCdir1
        # Check IIS is not installed on the server
        invoke-command -computername $ServerName -scriptbloc {get-windowsfeature web-server} | ft pscomputername,installed -autosize

    # A configuration is pushed to a node via cmdlet start-DSCConfiguration
        # Check the MOF are present in both directories
        dir C:\temp\ConfigDir1,C:\temp\MyWebConfig

        # Push configuration configDir1 we created previously. 
        # Note we don't specify the name of the servers since DSC will push the configuration for each MOF file it finds
        start-DSCConfiguration -path C:\temp\ConfigDir1 -wait -verbose
        
        # Check the deployed configuration has created c:\temp\DSCDir1 on local server
        get-item C:\temp\DSCdir1

        
        # Push configuration MyWebConfig we created previously to the server
        # Here, we don't use parameter -wait so the configuration will be pushed via a job
        $job = start-DSCConfiguration -path C:\temp\MywebConfig -verbose

        # Get the status of the job 
        get-job $job.id

        # Get output from the job 
        receive-job $job.id

        # Check web apps folder has been created on the server with the content from \\didadm1\WebApps
        dir \\$servername\c$\inetpub\wwwroot

        # Check IIS has been installed on the server
        invoke-command -computername $servername -scriptbloc {get-windowsfeature web-server} | ft pscomputername,installed -autosize

        # Test DSC configuration drift
            # Test local DSC configuration
            Test-DscConfiguration -path C:\temp\ConfigDir1 

            # Delete the folder 
            remove-item C:\temp\DSCdir1

            # Test again local DSC configuration which is now false 
            Test-DscConfiguration -path C:\temp\ConfigDir1 
            
            # Re-apply the configuration
            start-DSCConfiguration -path C:\temp\ConfigDir1 -wait -verbose
            
            # Test again local DSC configuration
            Test-DscConfiguration -path C:\temp\ConfigDir1 

            # Test the DSC configuration of the server
                # First, establish a cimsession with the server
                $s1 = New-CimSession -ComputerName $servername
                # Test the configuration of the server. Properties "InDesiredState" is set to $true which means it is compliant
                Test-DscConfiguration -CimSession $s1 -path c:\temp\MyWebConfig
                # Delete the web apps files on the server
                dir \\$servername\c$\inetpub\wwwroot -recurse | remove-item -force
                # Remove IIS on the server
                invoke-command -computername $servername -scriptbloc {remove-windowsfeature web-server}

                # Test the configuration of the server . Now, properties "InDesiredState" are set to $false which means it is not compliant
                Test-DscConfiguration -CimSession $s1 c:\temp\MyWebConfig
                # Re-apply the configuration in wait and debug mode to get more information
                start-DSCConfiguration -path C:\temp\MywebConfig -wait -debug
                # Test the configuration of the server. Now, properties "InDesiredState" is set to $true which means it is compliant
                Test-DscConfiguration -CimSession $s1 -path c:\temp\MyWebConfig

        # Remove what has been installed
        get-job | remove-job
        remove-item C:\temp\DSCdir1
        dir \\$servername\c$\inetpub\wwwroot -recurse | remove-item -force
        invoke-command -computername $servername -scriptbloc {remove-windowsfeature web-server}
        restart-computer -computername $servername -Force

